# ==========================================
# 1. 谷歌免费大模型 API 配置 (Google Gemini Free Tier)
# ==========================================
# 前往谷歌 AI Studio 免费获取：https://aistudio.google.com/app/apikey
# 拥有谷歌账号即可直接免费创建 API Key（以 AIza 开头）
# 填入 Key 后系统会自动适配谷歌官方接口与 gemini-1.5-flash 免费模型
LLM_API_KEY=AIzaSy...

# 若需要自定义配置，可取消下方注释：
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-1.5-flash

# ==========================================
# 2. QQ 邮箱推送配置 (推送到 897418752@qq.com)
# ==========================================
# 发件服务器与端口（QQ 邮箱固定如下即可）
MAIL_HOST=smtp.qq.com
MAIL_PORT=465

# 你的发件 QQ 邮箱
MAIL_USER=897418752@qq.com

# 接收晨报的目标邮箱
MAIL_TO=897418752@qq.com

# ⚠️ 注意：此处不是你的 QQ 密码！而是 QQ 邮箱生成的「POP3/SMTP 授权码」
# 获取步骤：电脑登录 mail.qq.com -> 设置 -> 账户 -> 开启「POP3/SMTP服务」-> 生成授权码（16位字母）
MAIL_PASS=your_qq_mail_auth_code_here

# ==========================================
# 3. 其他推送备选通道 (按需，可留空)
# ==========================================
PUSHPLUS_TOKEN=
SERVERCHAN_KEY=
FEISHU_WEBHOOK=
WECOM_WEBHOOK=
DINGTALK_WEBHOOK=
